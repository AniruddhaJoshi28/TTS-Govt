# Copy to .env and adjust. All settings use the GR_ prefix (see core/config/settings.py).

# --- Required in production ---
GR_ADMIN_API_TOKEN=replace-with-a-long-random-token
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-too

# --- Crawler etiquette (conservative defaults) ---
GR_USER_AGENT=GovGRArchiveBot/0.1 (+self-hosted public-records archive; contact: you@example.org)
GR_MIN_REQUEST_INTERVAL_S=2.0
GR_MAX_RETRIES=4
GR_OBEY_ROBOTS_TXT=true
GR_MAX_PDF_BYTES=83886080

# --- OCR ---
GR_OCR_ENABLED=true
GR_OCR_MIN_CHARS_PER_PAGE=40

# --- Local development without Docker (SQLite + local files, jobs run inline) ---
# GR_DATABASE_URL=sqlite:///data/gr_platform.sqlite3
# GR_STORAGE_BACKEND=local
# GR_REDIS_URL=
